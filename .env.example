# 复制为 .env 用于本地开发:  cp .env.example .env
#
# SQLite 连接串。本地开发用相对路径即可;
# 生产环境必须指向持久卷,形如 file:/data/trade.db(容器启动脚本会校验前缀)。
# 注意:相对路径以 prisma/ 目录(schema.prisma 所在处)为基准解析——file:./dev.db 指向 prisma/dev.db,
# 写成 file:./prisma/dev.db 会落到不存在的 prisma/prisma/dev.db,服务端对着一个新建的空库跑。
DATABASE_URL="file:./dev.db"

# 会话 cookie 的 HMAC 签名密钥。本地 dev 有内置回退,可不设;
# 生产环境必须设置,否则拒绝启动。生成方式:openssl rand -hex 32
# SESSION_SECRET=

# 可选:设为 1 时不启动做市机器人
# BOT_DISABLED=

# 可选:做市机器人节奏(毫秒),默认 2500。本地想让盘口更密可设 500;生产不改
# BOT_TICK_MS=

# 可选:设为 1 时不启动影子价格采集循环(每日一次,采 CEA/CCER 官方收盘价做内部对照)
# SYNC_DISABLED=

# 可选:机器人历史数据保留天数(机器人之间的成交、机器人的终态订单与账本流水;真人数据永久保留),默认 7
# RETENTION_DAYS=

# 可选:反代密钥。生产环境在 Cloudflare Worker 前置反代下,Worker 转发时注入
# 请求头 x-proxy-secret=<此值>;应用只在该头匹配时才信任 cf-connecting-ip 做限流分桶,
# 从而阻止直连 *.up.railway.app 伪造客户端 IP 绕过限流。生成方式:openssl rand -hex 32
# PROXY_SECRET=

# 可选:登记簿数据上游。Projects 与 Market data 两页读的是 carbadia.io 的公开接口 /api/real/*,
# 本站的 /api/real/[...path] 路由把请求代理到这里并缓存 5 分钟。默认 https://carbadia.io
# REGISTRY_UPSTREAM=

# ---- 自定义 server(server.mjs:Next + WebSocket /ws 同端口)。全部有代码内默认,生产不需要新增变量 ----

# 可选:启动方式,custom(默认,node server.mjs,带 /ws)| next(回滚到 next start,无 /ws,终端自动降级轮询)。
# 只由 docker-entrypoint.sh 读取;本地对应 npm run dev / npm run dev:plain
# START_MODE=custom

# 可选:设为 1 时 server.mjs 不挂 /ws(仍是自定义 server),/api/health 的 ws.enabled 为 false
# WS_DISABLED=

# 可选:/ws 总连接上限,超出的握手回 HTTP 503 + Retry-After: 30。默认 500
# WS_MAX_CONNECTIONS=500

# 可选:/ws 每 IP 连接上限(IP 经 PROXY_SECRET 信任链解析;直连与本地开发不受此限,只受总上限约束)。默认 8
# WS_MAX_PER_IP=8

# 可选:/ws 放行的 Origin,逗号分隔,`:*` 结尾表示任意端口。默认 https://cbda.trade;非生产环境额外放行 http://localhost:*
# WS_ALLOWED_ORIGINS=https://cbda.trade

# 可选:RSS 告警阈值(MB),每 30 s 采样,超过只打告警日志不退出。默认 900
# MAX_RSS_MB=900

# ---- 构建期(NEXT_PUBLIC_*,打进前端包,改了要重新 build)----

# 可选:终端行情传输方式,ws(默认)| poll(强制轮询 /api/market/*)
# NEXT_PUBLIC_MARKET_TRANSPORT=ws

# 可选:WebSocket 地址,默认同源 /ws(https 页面自动用 wss)
# NEXT_PUBLIC_WS_URL=
