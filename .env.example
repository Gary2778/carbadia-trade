# 复制为 .env 用于本地开发:  cp .env.example .env
#
# SQLite 连接串。本地开发用相对路径即可;
# 生产环境必须指向持久卷,形如 file:/data/trade.db(容器启动脚本会校验前缀)。
DATABASE_URL="file:./dev.db"

# 会话 cookie 的 HMAC 签名密钥。本地 dev 有内置回退,可不设;
# 生产环境必须设置,否则拒绝启动。生成方式:openssl rand -hex 32
# SESSION_SECRET=

# 可选:设为 1 时不启动做市机器人
# BOT_DISABLED=

# 可选:设为 1 时不启动影子价格采集循环(每日一次,采 CEA/CCER 官方收盘价做内部对照)
# SYNC_DISABLED=

# 可选:机器人历史数据保留天数(机器人之间的成交、机器人的终态订单与账本流水;真人数据永久保留),默认 7
# RETENTION_DAYS=

# 可选:反代密钥。生产环境在 Cloudflare Worker 前置反代下,Worker 转发时注入
# 请求头 x-proxy-secret=<此值>;应用只在该头匹配时才信任 cf-connecting-ip 做限流分桶,
# 从而阻止直连 *.up.railway.app 伪造客户端 IP 绕过限流。生成方式:openssl rand -hex 32
# PROXY_SECRET=

# 可选:登记簿数据上游。Projects 与 Market data 两页读的是 carbadia.io 的公开接口 /api/real/*,
# 本站的 /api/real/[...path] 路由把请求代理到这里并缓存 5 分钟。默认 https://carbadia.io
# REGISTRY_UPSTREAM=
