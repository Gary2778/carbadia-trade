  "private": true,
  "engines": {
    "node": ">=22.13 <27"
  },
  "scripts": {
    "dev": "node server.mjs",
    "dev:plain": "next dev",
    "build": "next build",
    "start": "NODE_ENV=production node server.mjs",
    "start:plain": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:worker": "node --test infra/cloudflare-proxy/worker.test.mjs",
    "smoke:ws": "node scripts/smoke-ws.mjs",
    "perf:chunks": "node scripts/perf/chunk-report.mjs",
    "perf:lh": "node scripts/perf/lighthouse.mjs",
    "perf:ws-flood": "node scripts/perf/ws-flood.mjs",
    "perf:ws-idle": "node scripts/perf/ws-idle.mjs",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:if-empty": "tsx prisma/seed-if-empty.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@tanstack/react-virtual": "^3.14.13",
    "lightweight-charts": "^5.2.1",
    "motion": "^12.40.0",
    "next": "16.3.6",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "ws": "^8.21.3",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "railway": "^3.11.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
